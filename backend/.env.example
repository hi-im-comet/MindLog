FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=your-secret-key-change-in-production

# Database (docker-compose 사용 시 DATABASE_URL/REDIS_URL은 compose에서 덮어씀)
DATABASE_URL=postgresql://mindlog:mindlog@localhost:5432/mindlog_db
TEST_DATABASE_URL=postgresql://mindlog:mindlog@localhost:5432/mindlog_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# CORS 허용 origin. 로컬 프론트 개발 시 http://localhost:5173 (Vite 기본 포트)
FRONTEND_URL=http://localhost:5173
